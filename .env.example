# Config do app web do Firebase.
# Console > Configurações do projeto > Seus aplicativos > app Web (</>).
#
# Estes valores são PÚBLICOS (vão para o bundle do cliente no build) —
# a segurança vem das security rules, não do sigilo deles. Ainda assim
# ficam fora do controle de versão por higiene e para separar projetos.
#
# Local: copie este arquivo para .env.local e preencha.
# Deploy: cadastre cada um como GitHub Secret com o MESMO nome (ver
#         .github/workflows/deploy.yml).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
